{
  "name": "martial-arts-manager",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "wrangler pages dev --local --port 5173",
    "dev:local": "vite",
    "build": "tsc -b && vite build",
    "mobile:web:build": "pnpm build",
    "mobile:cap:add:android": "cap add android",
    "mobile:cap:sync": "pnpm mobile:web:build && cap sync",
    "mobile:cap:sync:android": "pnpm mobile:web:build && cap sync android",
    "mobile:cap:android": "pnpm mobile:cap:sync && cap open android",
    "mobile:apk:open": "cap open android",
    "mobile:apk:doctor": "cap doctor",
    "mobile:apk:build:debug": "cd android && gradlew.bat assembleDebug",
    "mobile:apk:build:release": "cd android && gradlew.bat assembleRelease",
    "mobile:cap:ios": "pnpm mobile:cap:sync && cap open ios",
    "mobile:twa:doctor": "bubblewrap doctor",
    "mobile:twa:init": "bubblewrap init --manifest https://hamarr.cl/manifest.webmanifest",
    "mobile:twa:build": "bubblewrap build",
    "mobile:twa:update": "bubblewrap update",
    "lint": "eslint .",
    "scan": "node scripts/scan.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build",
    "predeploy": "pnpm typecheck && pnpm lint && pnpm test:run",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name=martial-arts-manager --branch=main && node scripts/post-deploy.mjs",
    "deploy:quick": "pnpm deploy",
    "db:local": "wrangler d1 execute martial-arts-db --local --file=./schema.sql",
    "db:prod": "wrangler d1 execute martial-arts-db --file=./schema.sql"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "^2.1.1",
    "daisyui": "^5.1.29",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.22",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.545.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-calendar": "^6.0.0",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.64.0",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.25.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.18",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "postcss": "^8.5.26",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.14",
      "tar@<7.5.7": ">=7.5.7",
      "tar@<=7.5.2": ">=7.5.3",
      "tar@<7.5.8": ">=7.5.8",
      "tar@<=7.5.9": ">=7.5.10",
      "file-type@>=13.0.0 <21.3.1": ">=21.3.1",
      "tar@<=7.5.10": ">=7.5.11",
      "tar@<=7.5.3": ">=7.5.4",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "uuid@<11.1.1": ">=11.1.1",
      "tar@<=7.5.15": ">=7.5.16",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "tar@<=7.5.17": ">=7.5.18",
      "tar@<=7.5.18": ">=7.5.19",
      "tar@<=7.5.16": ">=7.5.17",
      "tar@<=7.5.20": ">=7.5.21"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide"
    ]
  }
}
